# Frontend (Vite) — variáveis de ambiente
#
# Copie para .env.local (dev) ou defina no build (prod). As variáveis VITE_* são
# "assadas" no bundle em BUILD TIME (vite build) — não são lidas em runtime.

# Endereço base da API do backend.
# - Dev: normalmente http://localhost:8080 (é o padrão se a variável ficar vazia).
# - Prod: a URL pública da API (ex.: https://app.seudominio.com.br). Precisa ser
#   passada como build arg/env no build do container do frontend (ver Dockerfile).
VITE_API_URL=http://localhost:8080

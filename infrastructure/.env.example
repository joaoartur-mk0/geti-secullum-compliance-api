# =============================================================================
# Template de variáveis de ambiente (SEM segredos).
#
# Uso:
#   cp .env.example .env      # e preencha os valores reais
#
# O arquivo .env real é gitignored (contém segredos e NÃO vai para o repositório).
# O Docker Compose lê este diretório automaticamente ao subir os stacks.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auditoria_db

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# --- API SecullumWEB (credenciais GLOBAIS, iguais para todos os tenants) ---
# Necessárias para a AUDITORIA (buscar batidas/funcionários). Não afetam os cadastros.
#
# Base da API de integração (endpoints de batidas/funcionários):
SECULLUM_API_URL=https://pontowebintegracaoexterna.secullum.com.br
# Endpoint de autenticação (OAuth2 password grant, client_id=3):
SECULLUM_AUTH_URL=https://autenticador.secullum.com.br/Token
# Credenciais de acesso (email e senha da conta Secullum):
SECULLUM_USERNAME=
SECULLUM_PASSWORD=
# Opcional: token estático fixo, só para teste rápido.
# ATENÇÃO: se preenchido, TEM PRECEDÊNCIA sobre o login acima (o app usa este token e
# NÃO autentica). Como o token da Secullum expira em ~1h, deixe VAZIO para usar o
# fluxo de login (username/password), que renova automaticamente.
SECULLUM_API_TOKEN=

# --- Evolution API (credenciais GLOBAIS: mesma apikey/base URL para todos os
# tenants; a instância de WhatsApp em si é POR TENANT, conectada pelo próprio
# cliente via POST /api/v1/whatsapp/instances, e fica salva no banco) ---
#
# Base da Evolution API (ex.: https://evolution.exemplo.com.br):
EVOLUTION_API_URL=
# Chave de API (header "apikey"):
EVOLUTION_API_KEY=
# Prefixo usado para derivar o nome de instância POR TENANT (ex.: "tenant-42").
# Evita colisão de nomes entre ambientes (dev/homolog/prod) que compartilhem o
# mesmo provedor.
EVOLUTION_INSTANCE_PREFIX=tenant

# --- Autenticação (login do painel interno) ---
# Ver backend/docs/05_Auth_Backend_Contract.md para o contrato completo.
#
# Chave de assinatura dos tokens JWT (login válido por 24h). OBRIGATÓRIO em produção
# (sem ela, o backend usa um valor fixo de desenvolvimento, inseguro). Gere um valor
# aleatório longo, ex.: `openssl rand -base64 48`.
JWT_SECRET=
# Credenciais do super admin criado automaticamente na subida do backend (seed).
# É o único jeito de obter o primeiro usuário, já que o cadastro (/auth/register)
# exige estar autenticado. Deixe vazio para pular o seed (ex.: se o usuário já existe).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opcional (default: "Super Admin"):
SEED_ADMIN_NAME=

# --- Produção (docker-compose.prod.yml) ---
# Domínio público da API, usado no label do Traefik (Host rule):
APP_DOMAIN=
# Domínio público do painel administrativo (frontend), usado no label do Traefik:
WEB_DOMAIN=
# Nome do certresolver já configurado no Traefik (ajuste ao nome real do seu setup):
TRAEFIK_CERT_RESOLVER=letsencrypt
